{
  "name": "ryeceps-portfolio",
  "version": "1.0.0",
  "private": true,
  "description": "Static portfolio validation and archive tests.",
  "scripts": {
    "test": "npm run validate:html && npm run validate:site && npm run test:archive",
    "validate:external": "node scripts/check-external-links.mjs",
    "validate:html": "html-validate \"*.html\" \"blog/*.html\"",
    "validate:local": "node scripts/check-local-responses.mjs",
    "validate:site": "node scripts/validate-site.mjs",
    "test:archive": "node scripts/test-projects.mjs",
    "sync:repos": "node scripts/sync-repositories.mjs",
    "sync:repos:check": "node scripts/sync-repositories.mjs --check"
  },
  "devDependencies": {
    "html-validate": "10.9.0",
    "jsdom": "28.1.0"
  }
}
